---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="404" locale="ja">
  <div class="px-5 py-20 text-center">
    <p class="text-6xl font-extralight text-[#2563eb]">404</p>
    <p class="text-base text-[#525252] mt-4">ページが見つかりませんでした</p>
    <p class="text-sm text-[#737373] mt-1">Page not found</p>
    <a
      href="/"
      class="inline-block mt-8 text-sm text-[#2563eb] hover:text-[#1d4ed8] font-medium transition-colors duration-150"
    >
      ← ホームに戻る / Back to home
    </a>
  </div>
</BaseLayout>
