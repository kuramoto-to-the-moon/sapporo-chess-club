---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

{/* locale="ja" は SSR のデフォルト。JS が URL やブラウザ言語を見て英語に切り替える */}
<BaseLayout title="404" locale="ja">
  <div class="px-5 py-20 text-center">
    <p class="text-6xl font-extralight text-primary">404</p>
    <p id="not-found-msg" class="text-base text-sub mt-4">ページが見つかりませんでした</p>
    <a
      id="not-found-link"
      href="/"
      class="inline-block mt-8 text-sm text-primary [@media(hover:hover)]:hover:underline underline-offset-2 font-medium"
    >
      ← ホームに戻る
    </a>
  </div>

  <script>
    const isEn = /^\/en(\/|$)/.test(location.pathname);
    if (isEn) {
      // 表示言語を英語に切り替えたら lang も追従させる (スクリーンリーダーの音声合成が
      // 日本語エンジンのまま英文を読んでしまうのを防ぐ)
      document.documentElement.lang = "en";
      const msg = document.getElementById("not-found-msg");
      const link = document.getElementById("not-found-link") as HTMLAnchorElement | null;
      if (msg) msg.textContent = "Page not found";
      if (link) { link.textContent = "← Back to home"; link.href = "/en/"; }
    }
  </script>
</BaseLayout>
