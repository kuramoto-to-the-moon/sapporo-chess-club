---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AnnouncementRow from "@/components/AnnouncementRow.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { t, getLocalePath, type Locale } from "@/i18n";
import {
  getArchivedAnnouncements,
  groupByYear,
  hasJaOnlyContent,
} from "@/lib/announcement";

interface Props {
  locale: Locale;
  /** 表示する年。未指定ならアーカイブの最新年が使われる。 */
  year?: number;
}

const { locale, year: yearProp } = Astro.props;
const i = t(locale);

const all = await getArchivedAnnouncements();
const yearMap = groupByYear(all);
const archivedYears = Array.from(yearMap.keys()).sort((a, b) => b - a);

// 表示対象年: prop 指定があればそれ、なければアーカイブの最新年
const selectedYear = yearProp ?? archivedYears[0] ?? null;
const entries = selectedYear ? (yearMap.get(selectedYear) ?? []) : [];

const showEnNotice = locale === "en" && entries.some(hasJaOnlyContent);

const activeHref = getLocalePath(locale, "/announcements");
const yearHref = (y: number) => getLocalePath(locale, `/announcements/archive/${y}`);

const pageTitle = selectedYear
  ? `${selectedYear}${i.schedule.yearSuffix}${i.announcements.archivePageTitle}`
  : i.announcements.archivePageTitle;
---

<BaseLayout title={pageTitle} locale={locale} description={i.seo.announcementsArchive.description} noindex={true}>
  <section class="px-5 pt-16 md:pt-20 pb-6">
    <div class="mb-4">
      <Breadcrumbs
        label={i.nav.breadcrumb}
        items={[
          { label: i.nav.home, href: getLocalePath(locale, "/") },
          { label: i.announcements.indexLabel, href: activeHref },
        ]}
      />
    </div>
    <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight">
      {i.announcements.archivePageTitle}
    </h1>

    {archivedYears.length > 0 && (
      <nav class="mt-6 flex flex-wrap gap-2" aria-label={i.announcements.archivePageTitle}>
        {archivedYears.map((y) => {
          const isActive = y === selectedYear;
          return (
            <a
              href={yearHref(y)}
              class:list={[
                "inline-flex items-center justify-center min-h-[36px] px-3.5 rounded-md text-sm font-medium",
                isActive
                  ? "bg-primary text-white"
                  : "bg-hairline text-sub [@media(hover:hover)]:hover:bg-edge",
              ]}
              aria-current={isActive ? "page" : undefined}
            >
              {y}{i.schedule.yearSuffix}
            </a>
          );
        })}
      </nav>
    )}

    {showEnNotice && (
      <p class="mt-4 text-xs text-primary italic">
        {i.announcements.englishNotAvailable}
      </p>
    )}
  </section>

  <section class="px-5 pb-10">
    {entries.length === 0 ? (
      <p class="text-sm text-muted">{i.announcements.archiveEmpty}</p>
    ) : (
      <ul class="flex flex-col">
        {entries.map((entry) => <AnnouncementRow entry={entry} locale={locale} />)}
      </ul>
    )}
  </section>
</BaseLayout>
