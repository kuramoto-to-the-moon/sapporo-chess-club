---
interface Props {
  label: string;
  variant?: "section" | "group";
}

const { label, variant = "section" } = Astro.props;
---

<h2 class={variant === "group"
  ? "text-sm font-semibold text-muted pb-2 border-b border-edge"
  : "text-xl font-normal text-ink mb-4 flex items-center gap-2.5"}>
  {variant === "section" && <span class="inline-block w-1 h-4 bg-primary"></span>}
  {label}
</h2>
