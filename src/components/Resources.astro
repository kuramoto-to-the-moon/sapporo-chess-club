---
import { getCollection } from "astro:content";
import { t, type Locale } from "@/i18n";
import { withBase } from "@/lib/utils";
import ExternalLinkIcon from "@/components/ExternalLinkIcon.astro";
import SectionHeader from "@/components/SectionHeader.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale);

const linksData = await getCollection("links");
const externalLinks = linksData[0]?.data.links ?? [];

const items = [
  ...externalLinks.map((link) => ({ label: link.title[locale], href: link.url })),
  { label: i.resources.pamphlet, href: withBase("/documents/sapporo_chess_pamphlet.pdf")! },
];
---

<section id="links" class="px-5 py-10">
  <SectionHeader label={i.resources.label} />
  <ul class="flex flex-col">
    {items.map((item) => (
      <li>
        <a
          href={item.href}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1.5 py-2 text-sm text-sub [@media(hover:hover)]:hover:text-primary [@media(hover:hover)]:hover:underline underline-offset-2"
        >
          <span>{item.label}</span>
          <span class="text-muted"><ExternalLinkIcon /></span>
          <span class="sr-only">{i.nav.openInNewTab}</span>
        </a>
      </li>
    ))}
  </ul>
</section>
