---
import { render } from "astro:content";
import { marked } from "marked";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { t, getLocalePath, type Locale } from "@/i18n";
import {
  pickTitle,
  pickDescription,
  hasJaOnlyContent,
  formatAnnouncementDate,
  type Announcement,
} from "@/lib/announcement";
import { buildBreadcrumbJsonLd, homeCrumb } from "@/lib/breadcrumb";
import { buildNewsArticleJsonLd } from "@/lib/jsonld";
import Breadcrumbs from "@/components/Breadcrumbs.astro";

interface Props {
  locale: Locale;
  entry: Announcement;
  prev: Announcement | null;
  next: Announcement | null;
}

const { locale, entry, prev, next } = Astro.props;
const i = t(locale);
const listHref = getLocalePath(locale, "/announcements");

const title = pickTitle(entry, locale);
const isJaFallback = locale === "en" && hasJaOnlyContent(entry);

// meta description: 本文先頭から抽出（160字で切る = Google の description 表示上限に合わせる）
const description = pickDescription(entry, locale, 155);

// ja は Astro の <Content /> で markdown body をレンダー、
// en は frontmatter の bodyEn 文字列を marked で HTML 化する。
const { Content } = await render(entry);
const enBodyHtml = entry.data.bodyEn ? marked.parse(entry.data.bodyEn) : null;

const canonicalUrl = new URL(
  getLocalePath(locale, `/announcements/${entry.id}`),
  Astro.site,
).toString();
const articleJsonLd = buildNewsArticleJsonLd({
  locale,
  title,
  description,
  date: entry.data.date,
  canonicalUrl,
  astroSite: Astro.site,
});

const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  homeCrumb(locale, Astro.site),
  { name: i.announcements.pageTitle, url: new URL(getLocalePath(locale, "/announcements/"), Astro.site).toString() },
  { name: title, url: canonicalUrl },
]);
---

<BaseLayout title={title} locale={locale} description={description}>
  <script type="application/ld+json" set:html={breadcrumbJsonLd} />
  <script type="application/ld+json" set:html={articleJsonLd} />
  <article class="px-5 pt-16 md:pt-20 pb-10">
    <Breadcrumbs
      label={i.nav.breadcrumb}
      items={[
        { label: i.nav.home, href: getLocalePath(locale, "/") },
        { label: i.announcements.indexLabel, href: listHref },
      ]}
    />

    {isJaFallback && (
      <p class="mt-4 text-xs text-primary italic animate-fade-in-up stagger-1">
        {i.announcements.englishNotAvailableDetail}
      </p>
    )}

    <p class="text-sm text-muted mt-6 tabular-nums animate-fade-in-up stagger-1"><time datetime={entry.data.date}>{formatAnnouncementDate(entry.data.date)}</time></p>
    <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mt-2 leading-tight animate-fade-in-up stagger-2">
      {title}
    </h1>

    <div class="mt-8 prose prose-neutral max-w-none animate-fade-in-up stagger-3">
      {locale === "ja" || !enBodyHtml ? (
        <Content />
      ) : (
        <Fragment set:html={enBodyHtml} />
      )}
    </div>

    {(prev || next) && (
      <nav class="flex justify-between mt-12 pt-6 border-t border-hairline text-sm" aria-label={i.announcements.paginationLabel}>
        {prev ? (
          <a href={getLocalePath(locale, `/announcements/${prev.id}`)} data-astro-prefetch class="group text-primary flex flex-col">
            <span class="text-xs text-muted">{i.announcements.prev}</span>
            <span class="font-medium [@media(hover:hover)]:group-hover:underline underline-offset-2">{pickTitle(prev, locale)}</span>
          </a>
        ) : <span></span>}
        {next ? (
          <a href={getLocalePath(locale, `/announcements/${next.id}`)} data-astro-prefetch class="group text-primary flex flex-col items-end text-right">
            <span class="text-xs text-muted">{i.announcements.next}</span>
            <span class="font-medium [@media(hover:hover)]:group-hover:underline underline-offset-2">{pickTitle(next, locale)}</span>
          </a>
        ) : <span></span>}
      </nav>
    )}
  </article>
</BaseLayout>
