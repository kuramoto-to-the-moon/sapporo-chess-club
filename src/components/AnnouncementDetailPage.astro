---
import { render } from "astro:content";
import { marked } from "marked";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { t, getLocalePath, type Locale } from "@/i18n";
import {
  pickTitle,
  pickDescription,
  hasJaOnlyContent,
  formatAnnouncementDate,
  type Announcement,
} from "@/lib/announcement";
import { buildBreadcrumbJsonLd, homeCrumb } from "@/lib/breadcrumb";

interface Props {
  locale: Locale;
  entry: Announcement;
  prev: Announcement | null;
  next: Announcement | null;
}

const { locale, entry, prev, next } = Astro.props;
const i = t(locale);
const listHref = getLocalePath(locale, "/announcements");

const title = pickTitle(entry, locale);
const isJaFallback = locale === "en" && hasJaOnlyContent(entry);

// meta description: 本文先頭から抽出（160字で切る = Google の description 表示上限に合わせる）
const description = pickDescription(entry, locale, 155);

// ja は Astro の <Content /> で markdown body をレンダー、
// en は frontmatter の bodyEn 文字列を marked で HTML 化する。
const { Content } = await render(entry);
const enBodyHtml = entry.data.bodyEn ? marked.parse(entry.data.bodyEn) : null;

// NewsArticle JSON-LD: お知らせをニュース記事としてマークアップ。
// inLanguage と isAccessibleForFree を明示することで多言語サイトとしての
// 理解を助け、rich result 適格性を上げる。
const canonicalUrl = new URL(
  getLocalePath(locale, `/announcements/${entry.id}`),
  Astro.site,
).toString();
const ogImage = new URL("/images/og.webp", Astro.site).toString();
const datePublishedIso = `${entry.data.date}T00:00:00+09:00`;
const articleJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: title,
  description,
  datePublished: datePublishedIso,
  dateModified: datePublishedIso,
  inLanguage: locale === "ja" ? "ja-JP" : "en-US",
  isAccessibleForFree: true,
  image: [ogImage],
  url: canonicalUrl,
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
  author: {
    "@type": "Organization",
    name: i.site.name,
    url: "https://sapporochessclub.com",
  },
  publisher: {
    "@type": "Organization",
    name: i.site.name,
    url: "https://sapporochessclub.com",
    logo: {
      "@type": "ImageObject",
      url: new URL("/icon-512.png", Astro.site).toString(),
    },
  },
});

const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  homeCrumb(locale, Astro.site),
  { name: i.announcements.pageTitle, url: new URL(getLocalePath(locale, "/announcements/"), Astro.site).toString() },
  { name: title, url: canonicalUrl },
]);
---

<BaseLayout title={title} locale={locale} description={description}>
  <script type="application/ld+json" set:html={breadcrumbJsonLd} />
  <script type="application/ld+json" set:html={articleJsonLd} />
  <article class="px-5 pt-16 md:pt-20 pb-10">
    <a href={listHref} data-astro-prefetch class="text-sm text-muted hover:text-primary transition-colors duration-150 animate-fade-in-up">
      {i.announcements.back}
    </a>

    {isJaFallback && (
      <p class="mt-4 text-xs text-primary italic animate-fade-in-up stagger-1">
        {i.announcements.englishNotAvailableDetail}
      </p>
    )}

    <p class="text-sm text-muted mt-6 tabular-nums animate-fade-in-up stagger-1">{formatAnnouncementDate(entry.data.date)}</p>
    <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mt-2 leading-tight animate-fade-in-up stagger-2">
      {title}
    </h1>

    <div class="mt-8 prose prose-sm prose-neutral max-w-none animate-fade-in-up stagger-3">
      {locale === "ja" || !enBodyHtml ? (
        <Content />
      ) : (
        <Fragment set:html={enBodyHtml} />
      )}
    </div>

    {(prev || next) && (
      <nav class="flex justify-between mt-12 pt-6 border-t border-hairline text-sm" aria-label="Announcement pagination">
        {prev ? (
          <a href={getLocalePath(locale, `/announcements/${prev.id}`)} data-astro-prefetch class="text-primary hover:text-primary-hover transition-colors duration-150 flex flex-col">
            <span class="text-xs text-muted">{i.announcements.prev}</span>
            <span class="font-medium">← {pickTitle(prev, locale)}</span>
          </a>
        ) : <span></span>}
        {next ? (
          <a href={getLocalePath(locale, `/announcements/${next.id}`)} data-astro-prefetch class="text-primary hover:text-primary-hover transition-colors duration-150 flex flex-col items-end text-right">
            <span class="text-xs text-muted">{i.announcements.next}</span>
            <span class="font-medium">{pickTitle(next, locale)} →</span>
          </a>
        ) : <span></span>}
      </nav>
    )}
  </article>
</BaseLayout>
