---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ScheduleTimeline from "@/components/ScheduleTimeline.astro";
import { t, getLocalePath, type Locale } from "@/i18n";
import { getSortedScheduleDates } from "@/lib/schedule-data";
import { buildBreadcrumbJsonLd, homeCrumb } from "@/lib/breadcrumb";
import { buildEventsJsonLd } from "@/lib/jsonld";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale);

const sorted = await getSortedScheduleDates();

// JSON-LD: 大会を Event としてマークアップ（過去含む）
const siteData = await getCollection("site");
const site = siteData[0].data;
const tournaments = sorted.filter((d) => d.type === "tournament");

const eventsJsonLd = buildEventsJsonLd(locale, tournaments, site, Astro.site);

const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  homeCrumb(locale, Astro.site),
  { name: i.schedule.pageTitle, url: new URL(getLocalePath(locale, "/schedule/"), Astro.site).toString() },
]);
---

<BaseLayout title={i.schedule.pageTitle} locale={locale} description={i.seo.schedule.description}>
  <script type="application/ld+json" set:html={breadcrumbJsonLd} />
  {eventsJsonLd && <script type="application/ld+json" set:html={eventsJsonLd} />}
  <section class="px-5 pt-16 md:pt-20 pb-6">
    <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight animate-fade-in-up">{i.schedule.pageTitle}</h1>
    <p class="text-sm text-muted mt-3 animate-fade-in-up stagger-1">{i.schedule.pageSubtitle}</p>
  </section>

  <section class="px-5 pb-10 animate-fade-in-up stagger-2">
    <ScheduleTimeline dates={sorted} locale={locale} />
  </section>
</BaseLayout>
