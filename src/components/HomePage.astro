---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/Hero.astro";
import Announcements from "@/components/Announcements.astro";
import Activities from "@/components/Activities.astro";
import About from "@/components/About.astro";
import Schedule from "@/components/Schedule.astro";
import ClubInfo from "@/components/ClubInfo.astro";
import ChessLessons from "@/components/ChessLessons.astro";
import Resources from "@/components/Resources.astro";
import Contact from "@/components/Contact.astro";
import { t, type Locale } from "@/i18n";
import { buildWebsiteJsonLd, buildClubJsonLd } from "@/lib/jsonld";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale);

const siteData = await getCollection("site");
const site = siteData[0].data;

const websiteJsonLd = buildWebsiteJsonLd(locale);
const clubJsonLd = buildClubJsonLd(locale, site, Astro.site);
---

<BaseLayout
  title={i.nav.home}
  locale={locale}
  description={i.seo.home.description}
  titleSuffix={i.seo.home.titleSuffix}
>
  <script type="application/ld+json" set:html={websiteJsonLd} />
  <script type="application/ld+json" set:html={clubJsonLd} />
  <Hero locale={locale} />
  {/* 罫線はこの 3 ブロックの境界にだけ入る。ブロック内は余白で分ける。
      境界は Schedule / About / ChessLessons が持つ border-t。
      料金・会場は「クラブ紹介を読んだ後でいい」情報なので ClubInfo は
      About/Activities の並びに置き、Schedule 直後には置かない */}
  <Schedule locale={locale} />
  <Announcements locale={locale} />

  <About locale={locale} />
  <Activities locale={locale} />
  <ClubInfo locale={locale} />

  <ChessLessons locale={locale} />
  <Resources locale={locale} />
  <Contact locale={locale} />
</BaseLayout>
