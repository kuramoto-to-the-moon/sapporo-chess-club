---
import { t, getLocalePath, type Locale } from "@/i18n";
import { getEventName, formatRoomLabel, pickNote, type ScheduleDate, type ScheduleGroup } from "@/lib/schedule";
import { formatMonthDay, getDayOfWeek } from "@/lib/date";
import ExternalLinkIcon from "@/components/ExternalLinkIcon.astro";

interface Props {
  /** 連続日をまとめた 1 エントリ。単日イベントは要素 1 件 */
  group: ScheduleGroup;
  locale: Locale;
}

const { group, locale } = Astro.props;
const i = t(locale);
const first = group[0];
const last = group[group.length - 1];
const isRange = group.length > 1;
const cancelled = first.cancelled === true;
const note = pickNote(first, locale);

const formatTime = (date: ScheduleDate) =>
  [date.startTime, date.endTime].filter(Boolean).join("–") || i.schedule.timeTbd;
const uniformTime = group.every((date) => formatTime(date) === formatTime(first));
const uniformRoom = group.every((date) => date.room === first.room);
// 時刻や部屋が日によって変わる大会は、日付を添えて各日を表示する。
const perDay = !uniformTime || !uniformRoom;
const sessions = perDay ? group : [first];
---

{(cancelled || isRange) && (
  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-1.5 text-2xs text-muted">
    {cancelled && (
      <span class="text-sub bg-surface border border-edge rounded-md px-1.5 py-0.5">
        {i.badge.cancelledTag}
      </span>
    )}
    {isRange && (
      <span class="inline-flex flex-wrap items-baseline gap-x-1 tabular-nums">
        {/* datetime は範囲を表せないので、開始日と終了日を分ける。 */}
        <time datetime={first.date}>{formatMonthDay(first.date)} ({getDayOfWeek(first.date, locale)})</time>
        <span>–</span>
        <time datetime={last.date}>{formatMonthDay(last.date)} ({getDayOfWeek(last.date, locale)})</time>
      </span>
    )}
  </div>
)}

<p class="text-sm font-semibold">
  {first.announcementSlug ? (
    <a
      href={getLocalePath(locale, `/announcements/${first.announcementSlug}`)}
      data-astro-prefetch
      class={`underline-offset-2 [@media(hover:hover)]:hover:underline ${cancelled ? "text-muted" : "text-primary"}`}
    >
      {/* リンク単独でも中止状態が伝わるようにする。 */}
      {cancelled && <span class="sr-only">{i.badge.cancelledTag}: </span>}
      {getEventName(first, locale)}
    </a>
  ) : (
    <span class={cancelled ? "text-muted" : "text-ink"}>{getEventName(first, locale)}</span>
  )}
</p>

{/* 中止した回の部屋と時刻は行き先の無い情報なので出さない。 */}
{!cancelled && (
  <div class="mt-1 flex flex-col gap-1.5">
    {sessions.map((date) => (
      <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
        {perDay && (
          <time datetime={date.date} class="text-2xs text-muted tabular-nums">
            {formatMonthDay(date.date)} ({getDayOfWeek(date.date, locale)})
          </time>
        )}
        <dl class="flex flex-wrap items-baseline gap-x-5 gap-y-1 text-xs text-sub tabular-nums">
          <div class="inline-flex items-baseline gap-2">
            <dt class="text-2xs text-muted">{i.schedule.timeLabel}</dt>
            <dd class="whitespace-nowrap">{formatTime(date)}</dd>
          </div>
          <div class="inline-flex items-baseline gap-2">
            <dt class="text-2xs text-muted">{i.schedule.roomLabel}</dt>
            <dd>{formatRoomLabel(date, locale)}</dd>
          </div>
        </dl>
      </div>
    ))}
  </div>
)}

{note && <p class="text-xs text-muted mt-2 leading-relaxed">{note}</p>}

{first.chessResults && (
  <p class="mt-1.5">
    <a
      href={first.chessResults}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1 text-xs text-primary [@media(hover:hover)]:hover:underline underline-offset-2"
    >
      {i.tournament.chessResults}
      <ExternalLinkIcon size={13} />
      <span class="sr-only">{i.nav.openInNewTab}</span>
    </a>
  </p>
)}
