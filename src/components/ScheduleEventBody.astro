---
import { t, getLocalePath, type Locale } from "@/i18n";
import { getEventName, formatScheduleMeta, type ScheduleDate } from "@/lib/schedule";

interface Props {
  date: ScheduleDate;
  locale: Locale;
}

const { date, locale } = Astro.props;
const i = t(locale);
const isTournament = date.type === "tournament";
const cancelled = date.cancelled === true;
// 中止は例会でも起こり得る → その場合も badge+title 行を出す
const showTitleRow = isTournament || cancelled;
const meta = formatScheduleMeta(date, locale);
// 状態は「中止」バッジ (テキスト) だけで伝える。取り消し線は多くのスクリーンリーダーが
// 読み上げず晴眼者向けの演出にしかならないため使わない。タイトル色は text-sub
// (本文と同じ濃さ、text-muted のような弱い階調ではない) に留める。
// リンクの場合だけ下線を足す: 色を primary から外した分、クリックできる見た目の
// 手がかりが失われるため (サイト全体でリンク=青の規約になっている)。
const titleClass = cancelled
  ? "text-sub underline decoration-1 underline-offset-2 [@media(hover:hover)]:hover:text-ink transition-colors duration-150"
  : "text-primary [@media(hover:hover)]:hover:text-primary-hover transition-colors duration-150";
---

{showTitleRow ? (
  <>
    <p class="text-sm font-semibold flex items-center gap-2 flex-wrap">
      {isTournament && (
        <span class="text-xs px-1.5 py-0.5 rounded bg-primary text-white font-semibold">
          {i.badge.tournamentTag}
        </span>
      )}
      {cancelled && (
        <span class="text-xs px-1.5 py-0.5 rounded bg-hairline text-sub font-semibold">
          {i.badge.cancelledTag}
        </span>
      )}
      {date.announcementSlug ? (
        <a
          href={getLocalePath(locale, `/announcements/${date.announcementSlug}`)}
          data-astro-prefetch
          class={titleClass}
        >
          {/* スクリーンリーダーの「リンク一覧」読み上げは直前のバッジ span を
              読まないため、リンク名自体にも状態を埋め込む (視覚上は非表示) */}
          {cancelled && <span class="sr-only">{i.badge.cancelledTag}: </span>}
          {getEventName(date, locale)}
        </a>
      ) : (
        <span class={titleClass}>{getEventName(date, locale)}</span>
      )}
    </p>
    <p class="text-xs text-muted mt-1">{meta}</p>
  </>
) : (
  <p class="text-sm">
    <span class="font-semibold">{getEventName(date, locale)}</span>
    <span class="text-muted ml-2">{meta}</span>
  </p>
)}
{date.note && (
  <p class="text-xs text-muted mt-1">{date.note[locale]}</p>
)}
