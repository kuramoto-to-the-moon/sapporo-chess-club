---
import { t, getLocalePath, type Locale } from "@/i18n";
import { getEventName, formatScheduleMeta, type ScheduleDate } from "@/lib/schedule";

interface Props {
  date: ScheduleDate;
  locale: Locale;
}

const { date, locale } = Astro.props;
const i = t(locale);
const isTournament = date.type === "tournament";
const cancelled = date.cancelled === true;
const meta = formatScheduleMeta(date, locale);
---

<p class="text-sm font-semibold flex items-center gap-2 flex-wrap">
  {isTournament && (
    <span class="text-xs px-1.5 py-0.5 rounded bg-primary text-white font-semibold">
      {i.badge.tournamentTag}
    </span>
  )}
  {cancelled && (
    <span class="text-xs px-1.5 py-0.5 rounded bg-hairline text-sub font-semibold">
      {i.badge.cancelledTag}
    </span>
  )}
  {date.announcementSlug ? (
    <a
      href={getLocalePath(locale, `/announcements/${date.announcementSlug}`)}
      data-astro-prefetch
      class="text-primary [@media(hover:hover)]:hover:underline underline-offset-2"
    >
      {/* SR の「リンク一覧」読みはバッジ span を読まないため、リンク名にも状態を含める */}
      {cancelled && <span class="sr-only">{i.badge.cancelledTag}: </span>}
      {getEventName(date, locale)}
    </a>
  ) : (
    <span>{getEventName(date, locale)}</span>
  )}
</p>
<p class="text-xs text-muted mt-1">{meta}</p>
{date.note && (
  <p class="text-xs text-muted mt-1">{date.note[locale]}</p>
)}
