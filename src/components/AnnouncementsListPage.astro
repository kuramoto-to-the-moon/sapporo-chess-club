---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AnnouncementRow from "@/components/AnnouncementRow.astro";
import RssIcon from "@/components/RssIcon.astro";
import { t, getLocalePath, type Locale } from "@/i18n";
import { withBase } from "@/lib/utils";
import {
  getActiveAnnouncements,
  getArchivedAnnouncements,
  groupByYear,
  hasJaOnlyContent,
} from "@/lib/announcement";
import { buildBreadcrumbJsonLd, homeCrumb } from "@/lib/breadcrumb";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale);

const entries = await getActiveAnnouncements();
const archivedCount = (await getArchivedAnnouncements()).length;

const showEnNotice = locale === "en" && entries.some(hasJaOnlyContent);

const grouped = Array.from(groupByYear(entries).entries()).sort((a, b) => b[0] - a[0]);

const archiveHref = getLocalePath(locale, "/announcements/archive");
const rssHref = withBase(locale === "ja" ? "/rss.xml" : "/en/rss.xml")!;

const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  homeCrumb(locale, Astro.site),
  { name: i.announcements.pageTitle, url: new URL(getLocalePath(locale, "/announcements/"), Astro.site).toString() },
]);
---

<BaseLayout title={i.announcements.pageTitle} locale={locale} description={i.seo.announcementsList.description}>
  <script type="application/ld+json" set:html={breadcrumbJsonLd} />
  <section class="px-5 pt-16 md:pt-20 pb-6">
    <div class="flex items-start justify-between gap-4">
      <div class="flex-1 min-w-0">
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight">
          {i.announcements.pageTitle}
        </h1>
        <p class="text-sm text-muted mt-3">
          {i.announcements.pageSubtitle}
        </p>
      </div>
      <div class="shrink-0 relative group">
        <a
          href={rssHref}
          class="relative inline-flex items-center justify-center w-10 h-10 rounded-md text-muted [@media(hover:hover)]:group-hover:text-[#f26522] [@media(hover:hover)]:group-hover:bg-surface before:content-[''] before:absolute before:-inset-2"
          aria-label={i.announcements.subscribeRss}
          aria-describedby="rss-tooltip"
        >
          <RssIcon />
        </a>
        <span
          id="rss-tooltip"
          role="tooltip"
          class="pointer-events-none absolute right-0 top-full mt-1 whitespace-nowrap rounded-md bg-white border border-edge text-sub text-xs px-2.5 py-1.5 shadow-sm opacity-0 [@media(hover:hover)]:group-hover:opacity-100 transition-opacity"
        >
          {i.announcements.subscribeRss}
        </span>
      </div>
    </div>
    {showEnNotice && (
      <p class="mt-4 text-xs text-primary italic">
        {i.announcements.englishNotAvailable}
      </p>
    )}
  </section>

  <section class="px-5 pb-10">
    {entries.length === 0 ? (
      <p class="text-sm text-muted">{i.announcements.empty}</p>
    ) : (
      grouped.map(([year, items]) => (
        <div class="mb-8">
          <h2 class="text-sm font-semibold uppercase tracking-wider text-muted mb-3 pb-2 border-b border-edge">
            {year}{i.schedule.yearSuffix}
          </h2>
          <ul class="flex flex-col">
            {items.map((entry) => <AnnouncementRow entry={entry} locale={locale} />)}
          </ul>
        </div>
      ))
    )}

    {archivedCount > 0 && (
      <div class="mt-10 pt-6 border-t border-hairline text-center">
        <a href={archiveHref} class="text-sm text-primary [@media(hover:hover)]:hover:underline underline-offset-2 font-medium">
          {i.announcements.viewArchive}
        </a>
      </div>
    )}
  </section>
</BaseLayout>
