---
import { getCollection } from "astro:content";
import { t, getLocalePath, type Locale } from "@/i18n";
import ExternalLinkIcon from "@/components/ExternalLinkIcon.astro";
import SectionHeader from "@/components/SectionHeader.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale);

const siteData = await getCollection("site");
const site = siteData[0].data;

// 部屋は開催日ごとに異なる (810A / 740 / 760 / 1010 …) ため会場欄には固定記載せず、
// 各回の部屋番号を持つスケジュールへ誘導する。
const scheduleHref = getLocalePath(locale, "/schedule/");
---

<section id="info" class="px-5 py-10">
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div class="flex flex-col">
      <SectionHeader label={i.clubInfo.fee} />
      <dl class="flex flex-col gap-2 text-sm text-sub">
        <div class="flex gap-3">
          <dt>{i.clubInfo.general}</dt>
          <dd class="font-medium text-ink">¥{site.fee.general.toLocaleString()}</dd>
        </div>
        <div class="flex gap-3">
          <dt>{i.clubInfo.students}</dt>
          <dd class="font-medium text-ink">¥{site.fee.student.toLocaleString()}</dd>
        </div>
        <div class="flex gap-3">
          <dt>{i.clubInfo.observation}</dt>
          <dd class="font-medium text-primary">{i.clubInfo.free}</dd>
        </div>
      </dl>
    </div>
    <div class="flex flex-col">
      <SectionHeader label={i.clubInfo.venue} />
      <div class="flex flex-col gap-1 text-sm text-sub">
        <p class="text-ink font-medium">{site.venue.name[locale]}</p>
        <p>
          {i.clubInfo.roomNotice}
          <a
            href={scheduleHref}
            class="text-primary [@media(hover:hover)]:hover:underline underline-offset-2"
          >
            {i.clubInfo.checkSchedule}
          </a>
        </p>
        <p>{site.venue.address[locale]}</p>
        <p class="text-muted text-xs mt-1">{site.venue.access[locale]}</p>
        <a
          href="https://www.google.com/maps/search/?api=1&query=%E3%81%8B%E3%81%A7%E3%82%8B2.7"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-sm text-primary [@media(hover:hover)]:hover:underline underline-offset-2 font-medium mt-1 w-fit"
        >
          {i.clubInfo.viewOnMap}
          <ExternalLinkIcon />
          <span class="sr-only">{i.nav.openInNewTab}</span>
        </a>
      </div>
    </div>
  </div>
</section>
