---
import { t, getLocalePath, type Locale } from "@/i18n";
import { getSortedAnnouncements, hasJaOnlyContent } from "@/lib/announcement";
import AnnouncementRow from "@/components/AnnouncementRow.astro";
import SectionHeader from "@/components/SectionHeader.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale);
const listHref = getLocalePath(locale, "/announcements");

const latest = (await getSortedAnnouncements()).slice(0, 2);
const showEnNotice = locale === "en" && latest.some(hasJaOnlyContent);
---

{latest.length > 0 && (
  <section id="announcements" class="px-5 py-10">
    <SectionHeader label={i.announcements.label} />
    {showEnNotice && (
      <p class="text-xs text-primary italic mb-1">{i.announcements.englishNotAvailableShort}</p>
    )}
    <ul class="flex flex-col">
      {latest.map((entry) => <AnnouncementRow entry={entry} locale={locale} fullDate />)}
    </ul>
    <a
      href={listHref}
      data-astro-prefetch
      class="inline-block mt-4 text-sm text-primary [@media(hover:hover)]:hover:underline underline-offset-2 font-medium"
    >
      {i.announcements.viewAll}
    </a>
  </section>
)}
