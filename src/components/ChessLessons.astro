---
import { getCollection } from "astro:content";
import { t, type Locale } from "@/i18n";
import ExternalLinkIcon from "@/components/ExternalLinkIcon.astro";
import SectionHeader from "@/components/SectionHeader.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale);

const lessonsData = await getCollection("lessons");
const lesson = lessonsData[0]?.data;
---

{lesson && (
  <section id="lessons" class="px-5 py-8 bg-surface border-t border-hairline">
    <SectionHeader label={i.lessons.label} />
    <p class="text-base font-semibold mb-1">{lesson.title[locale]}</p>
    <p class="text-sm text-muted leading-[1.7]">{lesson.description[locale]}</p>
    {lesson.url && (
      <a
        href={lesson.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 mt-2 text-sm text-primary [@media(hover:hover)]:hover:underline underline-offset-2 font-medium"
      >
        {i.lessons.viewDetails}
        <ExternalLinkIcon />
        <span class="sr-only">{i.nav.openInNewTab}</span>
      </a>
    )}
  </section>
)}
