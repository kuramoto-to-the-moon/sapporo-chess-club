---
import HamburgerMenu from "./HamburgerMenu.astro";
import LanguageToggle from "./LanguageToggle.astro";
import { t, getLocalePath, type Locale } from "@/i18n";
import { getTopNavPages, normalizePath } from "@/lib/nav";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale);
const currentPath = normalizePath(Astro.url.pathname)
  .replace(/^\/en(\/|$)/, "/");
const homeHref = getLocalePath(locale, "/");
const topNavPages = getTopNavPages(locale);
---

<header
  id="site-header"
  class="sticky top-0 z-30 border-b border-hairline bg-white/95 backdrop-blur-sm transition-transform duration-500 ease-in-out data-[state=hidden]:-translate-y-full"
>
  <div class="max-w-4xl mx-auto flex items-center justify-between px-5 pt-3 pb-2">
    <a
      href={homeHref}
      class="text-xs tracking-[3px] text-muted [@media(hover:hover)]:hover:text-primary transition-colors duration-150"
      aria-label={i.nav.homeLink}
    >
      SAPPORO CHESS CLUB
    </a>
    <nav class="hidden md:flex items-center gap-1" aria-label={i.nav.mainNav}>
      {topNavPages.map((page) => (
        <a
          href={page.href}
          data-astro-prefetch
          class="text-sm text-sub [@media(hover:hover)]:hover:text-primary transition-colors duration-150 px-3 py-2 -my-2 rounded"
          aria-current={currentPath === page.path ? "page" : undefined}
        >
          {page.label}
        </a>
      ))}
      <span class="w-px h-4 bg-edge mx-2" aria-hidden="true"></span>
      <LanguageToggle locale={locale} path={currentPath} />
    </nav>
    <div class="md:hidden w-10 h-10">
      <HamburgerMenu locale={locale} currentPath={currentPath} />
    </div>
  </div>
</header>

<script>
  import { observeScroll } from "@/lib/scroll-observer";

  // Astro <script> は type="module" でバンドルされるため DOM 解析後に実行される。
  const headerEl = document.getElementById("site-header");
  if (headerEl) {
    initHeadroom(headerEl);
  }

  function initHeadroom(header: HTMLElement) {
    const TOP_THRESHOLD = 100;

    let frozen = false;

    // headroom を一時凍結 → scrollend (Baseline: Safari 26.2 で全ブラウザ到達) で解除。
    // スクロールが発生しないケース (アンカーが既に画面内) と scrollend 未対応の
    // 旧ブラウザのために安全タイマーを併走させる。
    function freezeUntilSettled() {
      if (frozen) return;
      frozen = true;
      header.removeAttribute("data-state");

      const unfreeze = () => {
        frozen = false;
        clearTimeout(timer);
        window.removeEventListener("scrollend", unfreeze);
      };
      const timer = setTimeout(unfreeze, 1500);
      window.addEventListener("scrollend", unfreeze, { once: true });
    }

    // 凍結トリガー:
    //   (a) 同一ページ内のアンカー click → HamburgerMenu 側から CustomEvent
    //   (b) クロスページのアンカー遷移 → 新ページが hash 付きでロードされた直後
    //       (ブラウザが自動的に target へスクロールする間を凍結)
    window.addEventListener("headroom:freeze", freezeUntilSettled);
    if (window.location.hash) freezeUntilSettled();

    observeScroll(({ y, direction, maxY }) => {
      if (frozen || y < TOP_THRESHOLD) {
        header.removeAttribute("data-state");
        return;
      }
      // 最下部付近ではラバーバンド対策として state を触らない
      if (y >= maxY - 4) return;
      if (direction === "down") header.dataset.state = "hidden";
      else if (direction === "up") header.removeAttribute("data-state");
    });
  }
</script>
