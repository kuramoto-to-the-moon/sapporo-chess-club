---
import { getCollection } from "astro:content";
import { t, type Locale } from "@/i18n";
import SectionHeader from "@/components/SectionHeader.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale);

const siteData = await getCollection("site");
const site = siteData[0].data;
---

<section id="contact" class="px-5 py-8 border-t border-hairline">
  <SectionHeader label={i.contact.label} />
  <p class="text-sm leading-[1.8] text-sub flex flex-col gap-1">
    {site.email && (
      <a href={`mailto:${site.email}`} class="[@media(hover:hover)]:hover:text-primary [@media(hover:hover)]:hover:underline underline-offset-2 transition-colors duration-150 w-fit">
        {site.email}
      </a>
    )}
  </p>
</section>
