---
import { t, getLocalePath, type Locale } from "@/i18n";
import { getNavPages } from "@/lib/nav";
import GlobeIcon from "@/components/GlobeIcon.astro";

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const i = t(locale);
const otherLocale: Locale = locale === "ja" ? "en" : "ja";
const otherPath = getLocalePath(otherLocale, currentPath);
const homeHref = getLocalePath(locale, "/");
const isHome = currentPath === "/" || currentPath === "";
const anchorHref = (id: string) => (isHome ? `#${id}` : `${homeHref}#${id}`);

const pages = getNavPages(locale);

const anchors = [
  { label: i.menu.activities, href: anchorHref("activities") },
  { label: i.about.label, href: anchorHref("about") },
  { label: i.menu.info, href: anchorHref("info") },
  { label: i.menu.lessons, href: anchorHref("lessons") },
  { label: i.menu.links, href: anchorHref("links") },
  { label: i.menu.contact, href: anchorHref("contact") },
];
---

<button
  type="button"
  id="hamburger-open"
  aria-label={i.menu.openLabel}
  aria-haspopup="dialog"
  aria-controls="hamburger-dialog"
  aria-expanded="false"
  class="relative inline-flex items-center justify-center w-10 h-10 -mr-2 cursor-pointer before:content-[''] before:absolute before:-inset-2"
>
  <span class="flex flex-col items-center justify-center gap-[6px]" aria-hidden="true">
    <span class="w-6 h-[2px] bg-ink"></span>
    <span class="w-6 h-[2px] bg-ink"></span>
  </span>
</button>

<dialog id="hamburger-dialog" class="hamburger-dialog" aria-label={i.menu.dialogLabel}>
  <div class="menu-sheet flex flex-col w-full h-full text-surface">
    <div class="w-full max-w-4xl mx-auto flex items-center justify-between px-5 pt-3 pb-2">
      <a
        href={homeHref}
        class="text-xs tracking-[3px] text-dim [@media(hover:hover)]:hover:text-surface transition-colors duration-150"
        aria-label={i.nav.homeLink}
      >
        SAPPORO CHESS CLUB
      </a>
      <button
        type="button"
        data-hamburger-close
        aria-label={i.menu.closeLabel}
        class="relative inline-flex items-center justify-center w-10 h-10 -mr-2 text-surface cursor-pointer rounded focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-surface before:content-[''] before:absolute before:-inset-2"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 6 6 18" />
          <path d="m6 6 12 12" />
        </svg>
      </button>
    </div>

    <nav class="flex-1 min-h-0 w-full max-w-4xl mx-auto px-5 pt-5 overflow-y-auto overscroll-contain" aria-label={i.nav.mainNav}>
      {pages.map((page) => (
        <a
          href={page.href}
          data-astro-prefetch
          class="block mb-4 [@media(hover:hover)]:hover:text-white transition-colors duration-150"
          aria-current={page.path === currentPath ? "page" : undefined}
        >
          <span class="text-3xl font-light">{page.label}</span>
        </a>
      ))}

      <hr class="border-0 border-t border-menu-line my-4" />

      <p class="text-xs uppercase tracking-wider text-dim mb-2">
        {i.menu.sectionLabel}
      </p>
      <div class="flex flex-col gap-2">
        {anchors.map((anchor) => (
          <a
            href={anchor.href}
            class="text-sm text-faint [@media(hover:hover)]:hover:text-surface transition-colors duration-150"
          >
            {anchor.label}
          </a>
        ))}
      </div>
    </nav>

    <div class="border-t border-menu-line [@media(display-mode:standalone)]:pb-[env(safe-area-inset-bottom)]">
      <div class="max-w-4xl mx-auto px-5 py-4">
        <a
          href={otherPath}
          class="flex items-center gap-2.5 text-sm text-faint [@media(hover:hover)]:hover:text-surface transition-colors duration-150"
          aria-label={i.nav.switchLanguage}
          hreflang={otherLocale}
        >
          <GlobeIcon size={16} stroke="currentColor" strokeWidth={1.5} />
          {i.nav.languageFull}
        </a>
      </div>
    </div>
  </div>
</dialog>

<style>
  /* <dialog> を全画面シートとして使う。showModal() で top-layer に入り、
     ESC / focus trap / inert backdrop がブラウザ側で自動的に機能する。 */
  .hamburger-dialog {
    padding: 0;
    border: 0;
    max-width: none;
    max-height: none;
    width: 100vw;
    height: 100vh; /* fallback */
    height: 100dvh;
    /* 暗幕は dialog 側に。中身が動いても背後が暗いままで透けない。
       prefers-reduced-motion は globals.css が全体で無効化。 */
    background: var(--color-ink);
    color: inherit;
    overflow: hidden;
    opacity: 0;
    /* 閉じ時のトランジション。display/overlay の尺は .menu-sheet の退場以上に保つこと
       (短いと中身が消え切る前に display:none で切り落とされる)。 */
    transition:
      opacity var(--dur-exit) var(--ease-exit),
      overlay var(--dur-exit) var(--ease-exit) allow-discrete,
      display var(--dur-exit) var(--ease-exit) allow-discrete;
  }
  .hamburger-dialog[open] {
    opacity: 1;
    /* 開き時: 画面いっぱいの暗幕なので calm。速い初速だと「バン」と鳴る */
    transition:
      opacity var(--dur-base) var(--ease-calm),
      overlay var(--dur-base) var(--ease-calm) allow-discrete,
      display var(--dur-base) var(--ease-calm) allow-discrete;
  }
  @starting-style {
    .hamburger-dialog[open] {
      opacity: 0;
    }
  }

  /* 中身の開閉アニメ。暗幕が dialog 側なので中身が動いても透けない。
     既定を「表示状態」にするのが肝: dialog が [open] の間は中身が必ず可視になり、
     「開いてるのに中身だけ透明＝暗幕だけ見えて真っ黒」という事故が起きない。 */
  .menu-sheet {
    /* 暗幕を敷いてから中身を置くまでの間。完全に同時だと黒い全画面と中身が
       一塊で飛び込んで派手になる */
    --dur-sheet-delay: 0.06s;
    opacity: 1;
    transform: translateY(0);
  }
  /* 閉じ（[open] が外れた瞬間〜display:none までの間）: 中身が下へ沈んで消える（開きの逆）。
     退場は遅らせない — 消えたいものが居座って見える。 */
  .hamburger-dialog:not([open]) .menu-sheet {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity var(--dur-exit) var(--ease-exit),
      transform var(--dur-exit) var(--ease-exit);
  }
  /* 開き: 暗幕と尺を揃え、わずかに遅らせて置く。完全に同時だと黒い全画面と中身が
     一塊で飛び込んで派手になる。段取りが見えると同じ速さでも静かに感じる。 */
  .hamburger-dialog[open] .menu-sheet {
    transition:
      opacity var(--dur-base) var(--ease-calm) var(--dur-sheet-delay),
      transform var(--dur-base) var(--ease-calm) var(--dur-sheet-delay);
  }
  /* display:none からの初回描画に開きの transition を効かせる開始状態。開くたび再生。 */
  @starting-style {
    .hamburger-dialog[open] .menu-sheet {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  .hamburger-dialog::backdrop {
    background: transparent;
  }
</style>

<script>
  const openBtn = document.getElementById("hamburger-open") as HTMLButtonElement | null;
  const dialog = document.getElementById("hamburger-dialog") as HTMLDialogElement | null;
  if (openBtn && dialog) {
    initHamburgerMenu(openBtn, dialog);
  }

  function initHamburgerMenu(openBtn: HTMLButtonElement, dialog: HTMLDialogElement) {
    // 開いた直後のフォーカス先。autofocus 属性はブラウザ実装差で信頼できないため
    // 明示的に JS で制御する。
    const closeBtn = dialog.querySelector<HTMLButtonElement>("[data-hamburger-close]");

    // ページ遷移中フラグ。遷移リンクタップ時は覆いを維持したいので、
    // その間の visibilitychange による即閉じをスキップさせる。
    let navigating = false;

    /** メニューを開く。開閉アニメは CSS (transition + @starting-style) が担う。*/
    function openMenu() {
      dialog.showModal();
      closeBtn?.focus({ preventScroll: true });
      openBtn.setAttribute("aria-expanded", "true");
    }

    /** メニューを閉じる（CSS のフェードアウト付き）。*/
    function closeMenu() {
      dialog.close();
    }

    /**
     * transition を挟まず即座に閉じる。close() は exit transition (allow-discrete) を
     * 走らせるため、bfcache 凍結や PWA バックグラウンドが transition の途中に起きると
     * dialog が「暗幕フェード途中」の状態で捕捉され、復元時に画面が真っ暗になる。
     * それを防ぐため、凍結/バックグラウンド時はアニメを外して即座に閉じる。
     */
    function closeInstant() {
      if (!dialog.open) return;
      dialog.style.transition = "none";
      dialog.close();
      requestAnimationFrame(() => { dialog.style.transition = ""; });
    }

    // 起動/復元時に dialog が [open] のまま描画されると、暗幕(dark)が画面を覆って
    // 真っ黒に見える。初期化時に開いていたら即座に閉じる（安全網）。
    closeInstant();

    /**
     * 同一ページ内アンカー用: メニューを閉じ、ヘッダー headroom を一時凍結する。
     * 凍結により、スクロール先まで移動する間にヘッダーが消えなくなる。
     */
    function closeMenuAndFreezeHeader() {
      closeMenu();
      window.dispatchEvent(new CustomEvent("headroom:freeze"));
    }

    openBtn.addEventListener("click", openMenu);

    // close: トリガーへフォーカス復帰 (ESC の a11y)
    dialog.addEventListener("close", () => {
      openBtn.setAttribute("aria-expanded", "false");
      openBtn.focus({ preventScroll: true });
    });

    // dialog 内クリックのデリゲート処理
    dialog.addEventListener("click", (e) => {
      const target = e.target as Element;
      if (target.closest("[data-hamburger-close]")) {
        closeMenu();
        return;
      }
      const link = target.closest("a[href]") as HTMLAnchorElement | null;
      const href = link?.getAttribute("href");
      if (!href) return;
      if (href.includes("#")) {
        // 同一ページ内 (#id) でも cross-page (/path#id) でもアンカーなら閉じる
        closeMenuAndFreezeHeader();
        return;
      }
      // その他のリンク (ページ遷移) では意図的に閉じない。
      // dialog を top-layer に残すことで、新ページが描画されるまで古いページを
      // 覆い隠せて、リンクタップ時のちらつきを防げる。
      // 遷移中は覆いを維持したいので、visibilitychange 側の即閉じをスキップさせる
      // （bfcache 対策は下の pagehide が担当）。
      navigating = true;
    });

    // 凍結/バックグラウンド時は即座に閉じ、真っ暗な状態で捕捉されるのを防ぐ。
    // - pagehide: bfcache 凍結直前（通常のページ遷移や離脱）。
    // - visibilitychange(hidden): PWA バックグラウンド（pagehide が発火しない環境）。
    //   ただしページ遷移中(navigating)は覆いを維持したいのでスキップ。
    // - pageshow(persisted): bfcache 復元時の safety net。
    window.addEventListener("pagehide", closeInstant);
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "hidden" && !navigating) closeInstant();
    });
    window.addEventListener("pageshow", (e: PageTransitionEvent) => {
      if (e.persisted) {
        navigating = false;
        closeInstant();
      }
    });
  }
</script>
