---
import { t, type Locale } from "@/i18n";
import SectionHeader from "@/components/SectionHeader.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale);

const cards = [
  { title: i.activities.meetup, desc: i.activities.meetupDesc },
  { title: i.activities.tournament, desc: i.activities.tournamentDesc },
  { title: i.activities.lesson, desc: i.activities.lessonDesc },
];
---

<section id="activities" class="px-5 py-8 border-t border-hairline">
  <SectionHeader label={i.activities.label} />
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
    {cards.map((card) => (
      <div class="flex flex-col justify-between bg-surface rounded-md p-4 min-h-[90px]">
        <p class="text-base font-semibold">{card.title}</p>
        <p class="text-xs text-muted mt-1">{card.desc}</p>
      </div>
    ))}
  </div>
</section>
