---
import { t, type Locale } from "@/i18n";
import SectionHeader from "@/components/SectionHeader.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale);
---

<section id="about" class="px-5 py-8 border-t border-hairline">
  <SectionHeader label={i.about.label} />
  <p class="text-sm leading-[1.8] text-sub">{i.about.body}</p>
</section>
