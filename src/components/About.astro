---
import { t, type Locale } from "@/i18n";
import SectionHeader from "@/components/SectionHeader.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale);
---

<section id="about" class="px-5 py-10 border-t border-edge">
  <SectionHeader label={i.about.label} />
  {/* text-wrap:pretty (globals の p 既定) は Safari で長文を詰めて右に余白を残すため、
      最長段落のここだけ greedy 折り返しに戻す */}
  <p class="text-sm leading-[1.8] text-sub [text-wrap:auto]">{i.about.body}</p>
</section>
