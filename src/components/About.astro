---
import { t, type Locale } from "@/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale);
---

<section id="about" class="px-5 py-6 border-t border-[#f5f5f5]">
  <h2 class="text-sm font-semibold uppercase tracking-wider text-[#737373] mb-4 flex items-center gap-2">
    <span class="inline-block w-1 h-3 bg-[#2563eb]"></span>
    {i.about.label}
  </h2>
  <p class="text-sm leading-[1.8] text-[#525252]">{i.about.body}</p>
</section>
