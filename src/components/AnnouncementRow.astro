---
import { getLocalePath, type Locale } from "@/i18n";
import { formatMonthDay } from "@/lib/date";
import {
  pickTitle,
  pickDescription,
  formatAnnouncementDate,
  type Announcement,
} from "@/lib/announcement";

interface Props {
  entry: Announcement;
  locale: Locale;
  /** true で "2026.04.12" 形式 + 広め幅（TOP 用）、既定は "04.12" 形式（一覧用） */
  fullDate?: boolean;
}

const { entry, locale, fullDate = false } = Astro.props;
const dateLabel = fullDate
  ? formatAnnouncementDate(entry.data.date)
  : formatMonthDay(entry.data.date);
const href = getLocalePath(locale, `/announcements/${entry.id}`);
---

{/* 行全体がタップ領域 (リンク) だが、リンクの見た目はサイト規約どおり
    「青いタイトル + hover 下線」が担う。行 hover の背景変化はリンク言語として
    サイト内で浮くためやめた */}
<li>
  <a
    href={href}
    class="group flex flex-col gap-1.5 py-4 border-b border-hairline last:border-0"
  >
    <div class="flex items-baseline gap-3">
      <time datetime={entry.data.date} class={`text-xs text-muted tabular-nums ${fullDate ? "min-w-[78px]" : "min-w-[60px]"} shrink-0`}>{dateLabel}</time>
      <span class="text-sm font-semibold text-primary [@media(hover:hover)]:group-hover:underline underline-offset-2 line-clamp-2 flex-1 min-w-0">{pickTitle(entry, locale)}</span>
    </div>
    <p class={`text-xs text-muted ${fullDate ? "ml-[90px]" : "ml-[72px]"} leading-[1.5] line-clamp-2 min-w-0`}>{pickDescription(entry, locale)}</p>
  </a>
</li>
