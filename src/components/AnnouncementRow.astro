---
import { getLocalePath, type Locale } from "@/i18n";
import { formatMonthDay } from "@/lib/date";
import {
  pickTitle,
  pickDescription,
  formatAnnouncementDate,
  type Announcement,
} from "@/lib/announcement";

interface Props {
  entry: Announcement;
  locale: Locale;
  /** true で "2026.04.12" 形式 + 広め幅（TOP 用）、既定は "04.12" 形式（一覧用） */
  fullDate?: boolean;
}

const { entry, locale, fullDate = false } = Astro.props;
const dateLabel = fullDate
  ? formatAnnouncementDate(entry.data.date)
  : formatMonthDay(entry.data.date);
const href = getLocalePath(locale, `/announcements/${entry.id}`);
---

<li>
  <a
    href={href}
    class="group flex flex-col gap-1 py-4 border-b border-hairline last:border-0"
  >
    <time datetime={entry.data.date} class="text-[12px] text-muted tabular-nums tracking-wide">{dateLabel}</time>
    <span class="text-[17px] font-semibold text-primary [@media(hover:hover)]:group-hover:underline underline-offset-2 line-clamp-2">{pickTitle(entry, locale)}</span>
    <p class="text-xs text-muted leading-[1.55] line-clamp-2">{pickDescription(entry, locale)}</p>
  </a>
</li>
