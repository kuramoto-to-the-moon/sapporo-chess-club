---
import { t, getLocalePath, type Locale } from "@/i18n";
import { getUpcomingScheduleDates } from "@/lib/schedule-data";
import ScheduleEventBody from "@/components/ScheduleEventBody.astro";
import SectionHeader from "@/components/SectionHeader.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale);
const scheduleHref = getLocalePath(locale, "/schedule");

const upcoming = await getUpcomingScheduleDates(3);
---

<section id="schedule" class="px-5 py-10 border-t border-edge">
  <SectionHeader label={i.schedule.label} />

  {upcoming.length === 0 ? (
    <p class="text-sm text-muted">
      {i.schedule.noUpcoming}
    </p>
  ) : (
    <>
      <ul class="flex flex-col">
        {upcoming.map((date) => {
          return (
            <li class="py-4 border-b border-hairline last:border-0">
              <ScheduleEventBody date={date} locale={locale} showMonth />
            </li>
          );
        })}
      </ul>
      <a
        href={scheduleHref}
        data-astro-prefetch
        class="inline-block mt-4 text-sm text-primary [@media(hover:hover)]:hover:underline underline-offset-2 font-medium"
      >
        {i.schedule.viewFullSchedule}
      </a>
    </>
  )}
</section>
