---
import { t, type Locale } from "@/i18n";
import { parseDate, getDateParts, getDayOfWeek, startOfTodayJST } from "@/lib/date";
import { type ScheduleDate } from "@/lib/schedule";
import ScheduleEventBody from "@/components/ScheduleEventBody.astro";

interface Props {
  dates: ScheduleDate[];
  locale: Locale;
}

const { dates, locale } = Astro.props;
const i = t(locale);

// 過去judge はビルド時の JST 今日基準。deploy.yml の日次再ビルドが毎日更新する
// （「今後の予定」フィルタと同じ仕組み）。
const today = startOfTodayJST();
const entries = dates.map((date, idx) => ({
  date,
  idx,
  isPast: parseDate(date.date) < today,
}));
// 「今日」ラインは最初の未来行の直前に引く。過去行が無ければ出さない
const firstUpcomingIdx = entries.find((e) => !e.isPast)?.idx ?? -1;
const showTodayMarker = firstUpcomingIdx > 0;

function getMonthKey(dateStr: string): string {
  const { year, month } = getDateParts(dateStr);
  return `${year}-${String(month).padStart(2, "0")}`;
}

const monthMap = new Map<string, typeof entries>();
for (const e of entries) {
  const key = getMonthKey(e.date.date);
  if (!monthMap.has(key)) monthMap.set(key, []);
  monthMap.get(key)!.push(e);
}
const groupedByMonth = Array.from(monthMap.entries()).map(([key, entries]) => ({ key, entries }));

function formatMonthHeading(monthKey: string): string {
  const [year, month] = monthKey.split("-");
  if (locale === "ja") {
    return `${year}${i.schedule.yearSuffix} ${parseInt(month)}${i.schedule.monthSuffix}`;
  }
  const d = new Date(`${monthKey}-01T00:00:00+09:00`);
  return new Intl.DateTimeFormat("en-US", {
    timeZone: "Asia/Tokyo",
    year: "numeric",
    month: "long",
  }).format(d);
}
---

<div class="flex flex-col gap-8">
  {groupedByMonth.map(({ key, entries: monthEntries }) => (
    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wider text-muted mb-3 pb-2 border-b border-edge">
        {formatMonthHeading(key)}
      </h2>
      <ul class="flex flex-col">
        {monthEntries.map((e) => (
          <>
            {showTodayMarker && e.idx === firstUpcomingIdx && (
              <li class="flex items-center gap-2 py-1">
                <span class="text-xs font-semibold tracking-wider text-primary">{i.schedule.today}</span>
                <span class="flex-1 h-px bg-primary" aria-hidden="true"></span>
              </li>
            )}
            {/* 過去行は背景ティントで区別する。opacity での減光は内包する全テキストが
                WCAG AA を割るため使わない (muted 文字は 45% で 1.8:1 まで落ちる) */}
            <li class={`flex items-baseline gap-4 py-4 border-b border-hairline last:border-0${e.isPast ? " bg-surface -mx-2 px-2 rounded" : ""}`}>
              <div class="flex items-baseline gap-1.5 min-w-[72px] shrink-0">
                <time datetime={e.date.date} class="text-xl font-semibold text-ink tabular-nums">{getDateParts(e.date.date).day}</time>
                <span class="text-xs text-muted">({getDayOfWeek(e.date.date, locale)})</span>
              </div>
              <div class="flex-1 min-w-0">
                <ScheduleEventBody date={e.date} locale={locale} />
              </div>
            </li>
          </>
        ))}
      </ul>
    </div>
  ))}
</div>
