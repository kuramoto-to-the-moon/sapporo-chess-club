---
import { t, type Locale } from "@/i18n";
import { getDateParts, getDayOfWeek } from "@/lib/date";
import { type ScheduleDate } from "@/lib/schedule";
import ScheduleEventBody from "@/components/ScheduleEventBody.astro";

interface Props {
  /** 表示する日程（呼び出し側でフィルタ済みを渡す） */
  dates: ScheduleDate[];
  locale: Locale;
}

const { dates, locale } = Astro.props;
const i = t(locale);

function getMonthKey(dateStr: string): string {
  const { year, month } = getDateParts(dateStr);
  return `${year}-${String(month).padStart(2, "0")}`;
}

const monthMap = new Map<string, ScheduleDate[]>();
for (const d of dates) {
  const key = getMonthKey(d.date);
  if (!monthMap.has(key)) monthMap.set(key, []);
  monthMap.get(key)!.push(d);
}
const groupedByMonth = Array.from(monthMap.entries()).map(([key, dates]) => ({ key, dates }));

function formatMonthHeading(monthKey: string): string {
  const [year, month] = monthKey.split("-");
  if (locale === "ja") {
    return `${year}${i.schedule.yearSuffix} ${parseInt(month)}${i.schedule.monthSuffix}`;
  }
  const d = new Date(`${monthKey}-01T00:00:00+09:00`);
  return new Intl.DateTimeFormat("en-US", {
    timeZone: "Asia/Tokyo",
    year: "numeric",
    month: "long",
  }).format(d);
}
---

{groupedByMonth.length === 0 && (
  <p class="text-sm text-muted">{i.schedule.noUpcoming}</p>
)}

<div class="flex flex-col gap-8">
  {groupedByMonth.map(({ key, dates: monthDates }) => (
    <div class="[content-visibility:auto] [contain-intrinsic-size:auto_320px]">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-muted mb-3 pb-2 border-b border-edge">
        {formatMonthHeading(key)}
      </h2>
      <ul class="flex flex-col">
        {monthDates.map((date) => (
          <li class="flex items-baseline gap-4 py-4 border-b border-hairline last:border-0">
            <div class="flex items-baseline gap-1.5 min-w-[72px] shrink-0">
              <time datetime={date.date} class="text-xl font-semibold text-ink tabular-nums">{getDateParts(date.date).day}</time>
              <span class="text-xs text-muted">({getDayOfWeek(date.date, locale)})</span>
            </div>
            <div class="flex-1 min-w-0">
              <ScheduleEventBody date={date} locale={locale} />
            </div>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>
