---
import { t, type Locale } from "@/i18n";
import { getDateParts, formatMonthDay, getDayOfWeek } from "@/lib/date";
import { type ScheduleDate } from "@/lib/schedule";
import ScheduleEventBody from "@/components/ScheduleEventBody.astro";

interface Props {
  dates: ScheduleDate[];
  locale: Locale;
}

const { dates, locale } = Astro.props;
const i = t(locale);

// お知らせ一覧と同じ「年見出し + MM.DD 行」構造。行が月を持つので月見出しは置かない
const yearMap = new Map<number, ScheduleDate[]>();
for (const d of dates) {
  const { year } = getDateParts(d.date);
  if (!yearMap.has(year)) yearMap.set(year, []);
  yearMap.get(year)!.push(d);
}
const groupedByYear = Array.from(yearMap.entries()).map(([year, dates]) => ({ year, dates }));
---

<div class="flex flex-col gap-8">
  {groupedByYear.map(({ year, dates: yearDates }) => (
    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wider text-muted mb-3 pb-2 border-b border-edge">
        {year}{i.schedule.yearSuffix}
      </h2>
      <ul class="flex flex-col">
        {yearDates.map((date) => (
          <li class="flex items-baseline gap-4 py-3 border-b border-hairline last:border-0">
            <div class="flex items-baseline gap-1.5 min-w-[80px] shrink-0">
              <span class="text-xl font-semibold text-ink tabular-nums">
                {formatMonthDay(date.date)}
              </span>
              <span class="text-xs text-muted">({getDayOfWeek(date.date, locale)})</span>
            </div>
            <div class="flex-1 min-w-0">
              <ScheduleEventBody date={date} locale={locale} />
            </div>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>
