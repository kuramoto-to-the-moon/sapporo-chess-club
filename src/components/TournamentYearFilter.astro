---
import { t, type Locale } from "@/i18n";

interface Props {
  years: number[];
  locale: Locale;
}

const { years, locale } = Astro.props;
const i = t(locale);

// aria-live 領域に書き込むテンプレート。フィルタ変更時にスクリーンリーダーへ
// 「選択中の年 + 表示件数」を告知する。{label} と {count} をスクリプトで置換。
const announceFormat = i.tournament.filterAnnounce;

// "all" を先頭に置いた年選択肢のリスト。モバイル select とデスクトップ pill で共有。
type YearOption = { value: string; label: string };
const allOption: YearOption = { value: "all", label: i.schedule.allYears };
const yearOptions: YearOption[] = years.map((y) => ({
  value: String(y),
  label: `${y}${i.schedule.yearSuffix}`,
}));
const selectOptions: YearOption[] = [allOption, ...yearOptions];

// デスクトップ pill は直近 N 年だけを常時表示し、それ以前は <details> の
// 折りたたみに逃がす。19 択を一度に並べると意思決定コストが跳ね上がるため。
// years は新しい順に並んでいる前提 (TournamentsPage 側で降順ソート済み)。
const RECENT_YEARS_COUNT = 4;
const recentOptions: YearOption[] = [allOption, ...yearOptions.slice(0, RECENT_YEARS_COUNT)];
const olderOptions: YearOption[] = yearOptions.slice(RECENT_YEARS_COUNT);

const pillClass =
  "inline-flex items-center justify-center min-h-[44px] px-3.5 rounded-md text-sm font-medium transition-colors cursor-pointer " +
  "aria-[pressed=true]:bg-primary aria-[pressed=true]:text-white " +
  "aria-[pressed=false]:bg-hairline aria-[pressed=false]:text-sub [@media(hover:hover)]:aria-[pressed=false]:hover:bg-edge";

const moreClass =
  "inline-flex items-center justify-center min-h-[44px] px-3.5 rounded-md text-sm font-medium transition-colors cursor-pointer " +
  "bg-hairline text-sub [@media(hover:hover)]:hover:bg-edge";

const optionClass =
  "w-full text-left px-3 py-2.5 text-sm text-ink cursor-pointer flex items-center justify-between [@media(hover:hover)]:hover:bg-hairline aria-[selected=true]:font-semibold";

const checkClass =
  "w-4 h-4 text-primary hidden aria-[selected=true]:inline";
---

<div>
  <div class="sm:hidden relative" data-filter-select>
    {/* label→button の関連付けはブラウザ/SR 実装差で不安定なので、span + aria-labelledby で
        「年で絞り込み + 現在値」をアクセシブルネームにする */}
    <span
      id="year-filter-label"
      class="block text-xs uppercase tracking-wider text-muted mb-2"
    >
      {i.schedule.filterByYear}
    </span>
    <button
      id="year-filter-trigger"
      type="button"
      data-filter-trigger
      aria-haspopup="listbox"
      aria-expanded="false"
      aria-labelledby="year-filter-label year-filter-current"
      aria-controls="year-filter-listbox"
      class="w-full min-h-[44px] rounded-md border border-edge bg-white px-3 flex items-center justify-between text-sm text-ink cursor-pointer [@media(hover:hover)]:hover:bg-surface transition-colors"
    >
      <span id="year-filter-current" data-filter-trigger-label>{allOption.label}</span>
      <svg
        data-filter-chevron
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="text-muted transition-transform duration-150"
        aria-hidden="true"
      >
        <path d="m6 9 6 6 6-6"/>
      </svg>
    </button>

    <ul
      id="year-filter-listbox"
      data-filter-listbox
      role="listbox"
      aria-label={i.schedule.filterByYear}
      hidden
      class="absolute left-0 right-0 top-full mt-1.5 z-20 bg-white border border-edge rounded-md shadow-lg max-h-72 overflow-y-auto py-1"
    >
      {/* li に role="presentation": listbox 直下は option でなければならず、
          li の暗黙 listitem role が挟まると SR が option 数を読めない */}
      {selectOptions.map((opt) => (
        <li role="presentation">
          <button
            type="button"
            role="option"
            data-filter-option={opt.value}
            data-filter-label={opt.label}
            aria-selected={opt.value === "all" ? "true" : "false"}
            class={optionClass}
          >
            <span>{opt.label}</span>
            <svg class={checkClass} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 6 9 17l-5-5"/>
            </svg>
          </button>
        </li>
      ))}
    </ul>
  </div>

  <div class="hidden sm:flex flex-wrap gap-2" role="group" aria-label={i.schedule.filterByYear}>
    {recentOptions.map((opt) => (
      <button
        type="button"
        data-filter-pill={opt.value}
        aria-pressed={opt.value === "all" ? "true" : "false"}
        class={pillClass}
      >
        {opt.value === "all" ? i.schedule.all : opt.value}
      </button>
    ))}
    {olderOptions.map((opt) => (
      <button
        type="button"
        data-filter-pill={opt.value}
        data-filter-pill-collapsed
        aria-pressed="false"
        hidden
        class={pillClass}
      >
        {opt.value}
      </button>
    ))}
    {olderOptions.length > 0 && (
      <button type="button" data-filter-more-toggle class={moreClass}>
        {i.schedule.moreYears} ({olderOptions.length})
      </button>
    )}
  </div>

  {/* スクリーンリーダー向けのライブリージョン。フィルタ変更を音声で告知する。 */}
  <p
    data-filter-live
    data-announce-format={announceFormat}
    aria-live="polite"
    aria-atomic="true"
    class="sr-only"
  ></p>
</div>

<script>
  import { initListbox } from "@/lib/listbox";

  const pills = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-filter-pill]")
  );
  const optionEls = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-filter-option]")
  );
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>("[data-card-year]")
  );
  const labelEl = document.querySelector<HTMLElement>("[data-filter-trigger-label]");
  const liveEl = document.querySelector<HTMLElement>("[data-filter-live]");
  const announceFormat = liveEl?.dataset.announceFormat ?? "";
  // value → ラベル文字列のマップ (モバイルトリガーと live 領域の表示更新に使う)
  // ラベルは各 option の data-filter-label 属性から読むので DOM 構造変更に強い
  const labelByValue = new Map(
    optionEls.map((el) => [el.dataset.filterOption ?? "", el.dataset.filterLabel ?? ""])
  );

  // 選択年を ?year= と同期 (replaceState = 履歴を積まない。"all" はパラメータなし)
  const YEAR_PARAM = "year";
  function syncUrl(year: string) {
    const url = new URL(location.href);
    if (year === "all") url.searchParams.delete(YEAR_PARAM);
    else url.searchParams.set(YEAR_PARAM, year);
    history.replaceState(null, "", url);
  }

  /** 選択された年を pill / listbox / カード表示 / URL / SR 告知に同期する */
  function applyYear(year: string) {
    let visible = 0;
    cards.forEach((c) => {
      const hidden = year !== "all" && c.dataset.cardYear !== year;
      c.hidden = hidden;
      if (!hidden) visible++;
    });
    pills.forEach((b) => {
      b.setAttribute("aria-pressed", b.dataset.filterPill === year ? "true" : "false");
    });
    optionEls.forEach((el) => {
      el.setAttribute("aria-selected", el.dataset.filterOption === year ? "true" : "false");
    });
    syncUrl(year);
    const label = labelByValue.get(year) ?? year;
    if (labelEl) labelEl.textContent = label;
    if (liveEl) {
      liveEl.textContent = announceFormat
        .replace("{label}", label)
        .replace("{count}", String(visible));
    }
  }

  // デスクトップ: pill ボタンで直接切替
  pills.forEach((b) => {
    b.addEventListener("click", () => applyYear(b.dataset.filterPill ?? "all"));
  });

  // 「もっと見る」: 押したら過去年 pill を表示し、トグル自体は消す (片方向の開示。
  // 一度開いたら閉じ直す UI は用意しない。<details> だと折りたたみが独立ブロック化し
  // 行がズレて見えたため、同じ flex-wrap 行内で hidden を切り替える方式にしている)
  const moreToggle = document.querySelector<HTMLButtonElement>("[data-filter-more-toggle]");
  const collapsedPills = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-filter-pill-collapsed]")
  );
  function revealOlderYears() {
    collapsedPills.forEach((p) => { p.hidden = false; });
    if (moreToggle) moreToggle.hidden = true;
  }
  moreToggle?.addEventListener("click", revealOlderYears);

  // URL に年指定があれば初期状態として復元 (不正値は labelByValue 照合で無視)
  const initialYear = new URLSearchParams(location.search).get(YEAR_PARAM);
  if (initialYear && labelByValue.has(initialYear)) {
    // 選択年が折りたたみ内にある場合は先に展開しておく
    if (collapsedPills.some((p) => p.dataset.filterPill === initialYear)) {
      revealOlderYears();
    }
    applyYear(initialYear);
  }

  // モバイル: listbox 開閉とキーボード操作は共通ヘルパーに委譲
  const root = document.querySelector<HTMLElement>("[data-filter-select]");
  const trigger = document.querySelector<HTMLButtonElement>("[data-filter-trigger]");
  const listbox = document.querySelector<HTMLUListElement>("[data-filter-listbox]");
  if (root && trigger && listbox) {
    initListbox({
      root,
      trigger,
      listbox,
      chevron: document.querySelector("[data-filter-chevron]"),
      options: optionEls,
      onSelect: (el) => applyYear(el.dataset.filterOption ?? "all"),
    });
  }
</script>
