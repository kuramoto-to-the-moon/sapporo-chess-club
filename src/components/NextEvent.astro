---
import { getCollection } from "astro:content";
import { t, getLocalePath, type Locale } from "@/i18n";
import { formatMonthDay, getDayOfWeek } from "@/lib/date";
import { getEventName } from "@/lib/schedule";
import { getUpcomingScheduleDates } from "@/lib/schedule-data";
import SectionHeader from "@/components/SectionHeader.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale);
const siteData = await getCollection("site");
const venueName = siteData[0].data.venue.name;

// getUpcomingScheduleDates は既に JST today 以降 / 昇順ソート済み
const [next] = await getUpcomingScheduleDates(1);
const isTournament = next?.type === "tournament";
const cancelled = next?.cancelled === true;
// 中止でも例会でも起こり得る → その場合も badge+title 行を出す
const showTitleRow = isTournament || cancelled;
// text-sub は本文と同じ通常の濃さ（弱い階調ではない）。ScheduleEventBody と同じ判断
const titleClass = cancelled
  ? "text-sub line-through"
  : "text-primary [@media(hover:hover)]:hover:text-primary-hover transition-colors duration-150";
---

{next && (
  <section class="px-5 py-8 border-t border-hairline animate-fade-in-up">
    <SectionHeader label={isTournament ? i.nextEvent.event : i.nextEvent.meeting} />
    <p class="flex items-baseline gap-2">
      <span class="text-5xl font-extralight leading-none text-primary tabular-nums">{formatMonthDay(next.date)}</span>
      <span class="text-lg text-muted">({getDayOfWeek(next.date, locale)})</span>
    </p>
    {showTitleRow && (
      <p class="text-base font-semibold mt-3 flex items-center gap-2">
        {isTournament && (
          <span class="text-xs px-1.5 py-0.5 rounded bg-primary text-white font-semibold">
            {i.badge.tournamentTag}
          </span>
        )}
        {cancelled && (
          <span class="text-xs px-1.5 py-0.5 rounded bg-hairline text-sub font-semibold">
            {i.badge.cancelledTag}
          </span>
        )}
        {next.announcementSlug ? (
          <a
            href={getLocalePath(locale, `/announcements/${next.announcementSlug}`)}
            data-astro-prefetch
            class={titleClass}
          >
            {getEventName(next, locale)}
          </a>
        ) : (
          <span class={titleClass}>{getEventName(next, locale)}</span>
        )}
      </p>
    )}
    <p class="text-sm text-muted mt-2">
      {next.startTime}–{next.endTime}{i.schedule.metaSeparator}{venueName[locale]} {next.room ? `${next.room}${i.schedule.roomSuffix}` : i.schedule.roomTbd}
    </p>
  </section>
)}
