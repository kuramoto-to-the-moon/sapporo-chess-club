---
import { getCollection } from "astro:content";
import { t, getLocalePath, type Locale } from "@/i18n";
import { formatMonthDay, getDayOfWeek } from "@/lib/date";
import { getEventName } from "@/lib/schedule";
import { getUpcomingScheduleDates } from "@/lib/schedule-data";
import SectionHeader from "@/components/SectionHeader.astro";
import ExternalLinkIcon from "@/components/ExternalLinkIcon.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale);
const siteData = await getCollection("site");
const venueName = siteData[0].data.venue.name;

// getUpcomingScheduleDates は既に JST today 以降 / 昇順ソート済み
const [next] = await getUpcomingScheduleDates(1);
const isTournament = next?.type === "tournament";
const cancelled = next?.cancelled === true;
const showTitleRow = isTournament || cancelled;
---

{next && (
  <section class="px-5 py-10 border-t border-edge animate-fade-in-up">
    <SectionHeader label={isTournament ? i.nextEvent.event : i.nextEvent.meeting} />
    <p class="flex items-baseline gap-2">
      <time datetime={next.date} class="text-5xl font-extralight leading-none text-primary tabular-nums">{formatMonthDay(next.date)}</time>
      <span class="text-lg text-muted">({getDayOfWeek(next.date, locale)})</span>
    </p>
    {showTitleRow && (
      <p class="text-base font-semibold mt-3 flex items-center gap-2">
        {isTournament && (
          <span class="text-xs px-1.5 py-0.5 rounded bg-primary text-white font-semibold">
            {i.badge.tournamentTag}
          </span>
        )}
        {cancelled && (
          <span class="text-xs px-1.5 py-0.5 rounded bg-hairline text-sub font-semibold">
            {i.badge.cancelledTag}
          </span>
        )}
        {next.announcementSlug ? (
          <a
            href={getLocalePath(locale, `/announcements/${next.announcementSlug}`)}
            data-astro-prefetch
            class="text-primary [@media(hover:hover)]:hover:underline underline-offset-2"
          >
            {cancelled && <span class="sr-only">{i.badge.cancelledTag}: </span>}
            {getEventName(next, locale)}
          </a>
        ) : (
          <span>{getEventName(next, locale)}</span>
        )}
      </p>
    )}
    <p class="text-sm text-muted mt-2 flex flex-wrap items-center gap-x-4 gap-y-1">
      <span>{next.startTime}–{next.endTime}</span>
      <span>{venueName[locale]} {next.room ? `${next.room}${i.schedule.roomSuffix}` : i.schedule.roomTbd}</span>
      {next.chessResults && (
        <a
          href={next.chessResults}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-primary [@media(hover:hover)]:hover:underline underline-offset-2"
        >
          {i.tournament.chessResults}
          <ExternalLinkIcon size={13} />
          <span class="sr-only">{i.nav.openInNewTab}</span>
        </a>
      )}
    </p>
  </section>
)}
