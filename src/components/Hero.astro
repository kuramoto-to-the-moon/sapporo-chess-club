---
import { t, type Locale } from "@/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale);
---

<section id="top" class="px-5 pt-16 md:pt-24 pb-7 relative">
  <h1 lang="ja" class="text-7xl md:text-8xl font-extrabold leading-[1.05] tracking-tight font-sans animate-fade-in-up" style="font-family: 'Hiragino Kaku Gothic ProN', 'Hiragino Sans', 'Noto Sans JP', 'Yu Gothic', 'Meiryo', sans-serif;">
    {/* span 間に空白・改行を入れないこと: HTML テキスト抽出で「札幌チェスクラブ」が
        連続文字列になり検索エンジンの完全一致対象になる。改行は CSS (block) で行う。 */}
    <span class="block">札幌</span><span class="block">チェス</span><span class="block">クラブ</span>
  </h1>
  <span
    class="absolute top-8 right-4 text-xs tracking-[2px] text-primary [writing-mode:vertical-rl] animate-fade-in stagger-1"
  >
    EST. 1990s — HOKKAIDO
  </span>
  <p class="mt-3.5 text-sm text-muted leading-[1.8] max-w-[220px] animate-fade-in-up stagger-1">
    {i.hero.subtitle}
  </p>
</section>
