---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import "@/styles/globals.css";
import { t, getLocalePath, type Locale } from "@/i18n";
import { normalizePath, stripLocalePrefix } from "@/lib/nav";

interface Props {
  title: string;
  locale: Locale;
  description?: string;
  /** ホームページで siteName の後ろに付ける補足文（SEOキーワード含む長いtitle用）。非ホームでは無視。 */
  titleSuffix?: string;
  /** true で <meta name="robots" content="noindex"> を出力。アーカイブ等に使う。 */
  noindex?: boolean;
}

const { title, locale, description, titleSuffix, noindex } = Astro.props;
const i = t(locale);

const siteName = i.site.name;
const isHomePage = title === i.nav.home;
const fullTitle = isHomePage
  ? (titleSuffix ? `${siteName}｜${titleSuffix}` : siteName)
  : `${siteName} | ${title}`;
const metaDescription = description ?? i.site.description;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const normalizedPath = normalizePath(Astro.url.pathname);
const ogImage = new URL("/images/og.webp", Astro.site).toString();

// hreflang: 検索エンジンに ja/en の対応関係を伝える。
// canonical と末尾スラッシュを揃える（Astro の静的出力は全ページ trailing slash 付き）。
const pagePath = stripLocalePrefix(normalizedPath);
const withTrailingSlash = (p: string) => (p === "/" ? "/" : `${p}/`);
const jaUrl = new URL(withTrailingSlash(pagePath), Astro.site).toString();
const enUrl = new URL(`/en${withTrailingSlash(pagePath)}`, Astro.site).toString();
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    {/* Google Analytics 4 */}
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-5CX3KE8FFP" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-5CX3KE8FFP');
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="ja" href={jaUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={jaUrl} />
    {locale === "ja" ? (
      <link rel="alternate" type="application/rss+xml" title={i.rss.title} href="/rss.xml" />
    ) : (
      <link rel="alternate" type="application/rss+xml" title={i.rss.title} href="/en/rss.xml" />
    )}

    {/* Security: GitHub Pages doesn't support custom HTTP headers, so we use
        meta http-equiv where possible. CSP via meta cannot set frame-ancestors,
        sandbox, or report-uri/report-to but the rest works. Inline scripts and
        styles are required for Astro hydration runtime + inlined Tailwind CSS,
        so 'unsafe-inline' is unavoidable. */}
    <meta
      http-equiv="Content-Security-Policy"
      content={[
        "default-src 'self'",
        "script-src 'self' 'unsafe-inline' https://www.googletagmanager.com",
        "style-src 'self' 'unsafe-inline'",
        "img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com",
        "font-src 'self'",
        "connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com",
        "form-action 'self'",
        "base-uri 'self'",
        "object-src 'none'",
        "manifest-src 'self'",
      ].join("; ")}
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    {/* Favicon — `<link rel="icon">` を複数宣言すると Google が選択を誤り、
         検索結果に favicon が表示されないケースが観測されたため、通常の
         favicon 宣言は撤廃。ブラウザ・Google はルート直下の /favicon.ico を
         無宣言でも取得しに来るため、この「独立配置」方式で曖昧さを排除する。
         apple-touch-icon は iOS ホーム画面向けの別系統なので残す。 */}
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    {/* PWA */}
    <link
      rel="manifest"
      href={`/${locale === "en" ? "manifest.en.webmanifest" : "manifest.webmanifest"}`}
    />
    <meta name="theme-color" content="#2563eb" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={siteName} />

    {/* Open Graph / X (旧 Twitter) カード。meta name="twitter:*" は
         X が現在もこの名前で読んでいるため変更不可。 */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={locale === "ja" ? "ja_JP" : "en_US"} />
    <meta property="og:locale:alternate" content={locale === "ja" ? "en_US" : "ja_JP"} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="bg-white text-[#171717] font-sans antialiased min-h-screen flex flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-100 focus:px-4 focus:py-2 focus:bg-[#2563eb] focus:text-white focus:rounded focus:text-sm focus:font-medium"
    >
      {i.nav.skipToMain}
    </a>
    <Header locale={locale} />
    <main id="main-content" class="max-w-4xl w-full mx-auto flex-1 animate-fade-in">
      <slot />
    </main>
    <Footer locale={locale} />

    {/* 非日本語ブラウザへの言語案内 pill (ja ページ + モバイル幅のみ)。
         デスクトップではヘッダーの LanguageToggle が常時見えるので不要。
         hidden 属性は JS が条件を満たした時だけ外す。md:hidden で
         デスクトップ幅では CSS で非表示にする。 */}
    {locale === "ja" && (
      <div
        id="lang-pill"
        hidden
        class="fixed bottom-6 left-1/2 -translate-x-1/2 z-40 md:hidden bg-[#2563eb] rounded-full pl-4 pr-3 py-2.5 shadow-lg flex items-center gap-3 whitespace-nowrap opacity-0 translate-y-3 [@media(display-mode:standalone)]:bottom-[calc(1.5rem+env(safe-area-inset-bottom))]"
        style="transition: opacity 300ms cubic-bezier(0.16, 1, 0.3, 1), translate 300ms cubic-bezier(0.16, 1, 0.3, 1);"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0">
          <circle cx="12" cy="12" r="10"/>
          <path d="M2 12h20"/>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
        </svg>
        <a
          href={getLocalePath("en", normalizedPath)}
          class="text-white text-[15px] font-semibold no-underline"
          data-lang-pill-link
        >
          {i.nav.switchLanguage}
        </a>
        <button
          type="button"
          data-lang-pill-close
          aria-label={i.nav.close}
          class="flex items-center justify-center w-7 h-7 rounded-full text-white/50 hover:text-white hover:bg-white/15 text-lg leading-none cursor-pointer bg-transparent border-0 transition-colors duration-150"
        >
          ×
        </button>
      </div>
    )}

    <script>
      initLangPill();
      function initLangPill() {
        const pill = document.getElementById("lang-pill");
        if (!pill) return;
        const forceShow = new URLSearchParams(location.search).has("force-lang-pill");
        const dismissed = !forceShow && localStorage.getItem("lang-pill-dismissed");
        const isJaBrowser = !forceShow && (navigator.language || "").startsWith("ja");
        if (dismissed || isJaBrowser) return;

        pill.hidden = false;
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            pill.classList.replace("opacity-0", "opacity-100");
            pill.classList.replace("translate-y-3", "translate-y-0");
          });
        });
        pill.querySelector("[data-lang-pill-close]")?.addEventListener("click", () => {
          localStorage.setItem("lang-pill-dismissed", "1");
          pill.classList.replace("opacity-100", "opacity-0");
          pill.classList.replace("translate-y-0", "translate-y-3");
          setTimeout(() => { pill.hidden = true; }, 300);
        });
        pill.querySelector("[data-lang-pill-link]")?.addEventListener("click", () => {
          localStorage.setItem("lang-pill-dismissed", "1");
        });
      }
    </script>
  </body>
</html>
