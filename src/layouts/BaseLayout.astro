---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ScrollTop from "@/components/ScrollTop.svelte";
import "@/styles/globals.css";
import { t, getLocalePath, type Locale } from "@/i18n";

interface Props {
  title: string;
  locale: Locale;
  description?: string;
}

const { title, locale, description } = Astro.props;
const i = t(locale);

const siteName = i.site.name;
const fullTitle = `${siteName} | ${title}`;
const metaDescription = description ?? i.site.description;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const normalizedPath = Astro.url.pathname.replace(new RegExp(`^${base}`), "").replace(/\/$/, "");
const isHome = normalizedPath === "" || normalizedPath === "/en";
const ogImage = new URL(`${base}/images/og.webp`, Astro.site).toString();
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalUrl} />
    {locale === "ja" ? (
      <link rel="alternate" type="application/rss+xml" title="札幌チェスクラブ お知らせ" href={`${base}/rss.xml`} />
    ) : (
      <link rel="alternate" type="application/rss+xml" title="Sapporo Chess Club — News" href={`${base}/en/rss.xml`} />
    )}

    {/* Security: GitHub Pages doesn't support custom HTTP headers, so we use
        meta http-equiv where possible. CSP via meta cannot set frame-ancestors,
        sandbox, or report-uri/report-to but the rest works. Inline scripts and
        styles are required for Astro hydration runtime + inlined Tailwind CSS,
        so 'unsafe-inline' is unavoidable. */}
    <meta
      http-equiv="Content-Security-Policy"
      content={[
        "default-src 'self'",
        "script-src 'self' 'unsafe-inline' 'unsafe-eval'",
        "style-src 'self' 'unsafe-inline'",
        "img-src 'self' data:",
        "font-src 'self'",
        "connect-src 'self' https://formspree.io",
        "form-action https://formspree.io",
        "base-uri 'self'",
        "object-src 'none'",
        "manifest-src 'self'",
      ].join("; ")}
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    {/* Favicon */}
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32x32.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />

    {/* PWA */}
    <link
      rel="manifest"
      href={`${base}/${locale === "en" ? "manifest.en.webmanifest" : "manifest.webmanifest"}`}
    />
    <meta name="theme-color" content="#2563eb" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={siteName} />

    {/* Twitter card type: large image since we have an OG image */}

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={locale === "ja" ? "ja_JP" : "en_US"} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="bg-white text-[#171717] font-sans antialiased min-h-screen flex flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-100 focus:px-4 focus:py-2 focus:bg-[#2563eb] focus:text-white focus:rounded focus:text-sm focus:font-medium"
    >
      {i.nav.skipToMain}
    </a>
    <Header locale={locale} />
    <main id="main-content" class="max-w-4xl w-full mx-auto flex-1 animate-fade-in">
      <slot />
    </main>
    <Footer locale={locale} />
    {!isHome && <ScrollTop client:idle />}

    {/* 非日本語ブラウザへの言語案内 pill (ja ページ + モバイル幅のみ)。
         デスクトップではヘッダーの LanguageToggle が常時見えるので不要。
         hidden 属性は JS が条件を満たした時だけ外す。md:hidden で
         デスクトップ幅では CSS で非表示にする。 */}
    {locale === "ja" && (
      <div
        id="lang-pill"
        hidden
        class="fixed bottom-6 left-1/2 -translate-x-1/2 z-40 md:hidden bg-[#2563eb] rounded-full pl-4 pr-3 py-2.5 shadow-lg flex items-center gap-3 opacity-0 translate-y-3 [@media(display-mode:standalone)]:bottom-[calc(1.5rem+env(safe-area-inset-bottom))]"
        style="transition: opacity 300ms cubic-bezier(0.16, 1, 0.3, 1), translate 300ms cubic-bezier(0.16, 1, 0.3, 1);"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0">
          <circle cx="12" cy="12" r="10"/>
          <path d="M2 12h20"/>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
        </svg>
        <a
          href={getLocalePath("en", normalizedPath || "/")}
          class="text-white text-[15px] font-semibold no-underline"
          data-lang-pill-link
        >
          View in English
        </a>
        <button
          type="button"
          data-lang-pill-close
          aria-label="Close"
          class="flex items-center justify-center w-7 h-7 rounded-full text-white/50 hover:text-white hover:bg-white/15 text-lg leading-none cursor-pointer bg-transparent border-0 transition-colors duration-150"
        >
          ×
        </button>
      </div>
    )}

    <script>
      const pill = document.getElementById("lang-pill");
      if (pill) {
        const forceShow = new URLSearchParams(location.search).has("force-lang-pill");
        const dismissed = !forceShow && localStorage.getItem("lang-pill-dismissed");
        const isJaBrowser = !forceShow && (navigator.language || "").startsWith("ja");
        if (!dismissed && !isJaBrowser) {
          pill.hidden = false;
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              pill.classList.replace("opacity-0", "opacity-100");
              pill.classList.replace("translate-y-3", "translate-y-0");
            });
          });
          function dismissPill() {
            localStorage.setItem("lang-pill-dismissed", "1");
            pill!.classList.replace("opacity-100", "opacity-0");
            pill!.classList.replace("translate-y-0", "translate-y-3");
            setTimeout(() => { pill!.hidden = true; }, 300);
          }
          pill.querySelector("[data-lang-pill-close]")?.addEventListener("click", dismissPill);
          pill.querySelector("[data-lang-pill-link]")?.addEventListener("click", () => {
            localStorage.setItem("lang-pill-dismissed", "1");
          });
        }
      }
    </script>
  </body>
</html>
