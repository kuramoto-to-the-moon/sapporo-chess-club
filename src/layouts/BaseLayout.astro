---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import GlobeIcon from "@/components/GlobeIcon.astro";
import "@/styles/globals.css";
import { t, getLocalePath, type Locale } from "@/i18n";
import { normalizePath, stripLocalePrefix } from "@/lib/nav";

interface Props {
  title: string;
  locale: Locale;
  description?: string;
  /** ホームページで siteName の後ろに付ける補足文（SEOキーワード含む長いtitle用）。非ホームでは無視。 */
  titleSuffix?: string;
  /** true で <meta name="robots" content="noindex"> を出力。アーカイブ等に使う。 */
  noindex?: boolean;
}

const { title, locale, description, titleSuffix, noindex } = Astro.props;
const i = t(locale);

const siteName = i.site.name;
const isHomePage = title === i.nav.home;
const fullTitle = isHomePage
  ? (titleSuffix ? `${siteName}｜${titleSuffix}` : siteName)
  : `${siteName} | ${title}`;
const metaDescription = description ?? i.site.description;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const normalizedPath = normalizePath(Astro.url.pathname);
const ogImage = new URL("/images/og.webp", Astro.site).toString();

// hreflang: 検索エンジンに ja/en の対応関係を伝える。
// canonical と末尾スラッシュを揃える（Astro の静的出力は全ページ trailing slash 付き）。
const pagePath = stripLocalePrefix(normalizedPath);
const withTrailingSlash = (p: string) => (p === "/" ? "/" : `${p}/`);
const jaUrl = new URL(withTrailingSlash(pagePath), Astro.site).toString();
const enUrl = new URL(`/en${withTrailingSlash(pagePath)}`, Astro.site).toString();
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    {/* Google Analytics 4
         gtag.js (~157KB) は LCP/FCP に不要なので load 完了 + アイドル後に注入し、
         初期表示のネットワークと競合させない。config は dataLayer に先積みされ、
         スクリプト到着時にまとめて処理される (page_view も欠けない)。 */}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-5CX3KE8FFP');
      (function () {
        function loadGtag() {
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-5CX3KE8FFP';
          document.head.appendChild(s);
        }
        function onIdle() {
          if ('requestIdleCallback' in window) requestIdleCallback(loadGtag, { timeout: 2000 });
          else setTimeout(loadGtag, 1500);
        }
        if (document.readyState === 'complete') onIdle();
        else window.addEventListener('load', onIdle);
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="ja" href={jaUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={jaUrl} />
    {locale === "ja" ? (
      <link rel="alternate" type="application/rss+xml" title={i.rss.title} href="/rss.xml" />
    ) : (
      <link rel="alternate" type="application/rss+xml" title={i.rss.title} href="/en/rss.xml" />
    )}

    {/* Security: GitHub Pages doesn't support custom HTTP headers, so we use
        meta http-equiv where possible. CSP via meta cannot set frame-ancestors,
        sandbox, or report-uri/report-to but the rest works. Inline scripts and
        styles are required for Astro hydration runtime + inlined Tailwind CSS,
        so 'unsafe-inline' is unavoidable. */}
    <meta
      http-equiv="Content-Security-Policy"
      content={[
        "default-src 'self'",
        "script-src 'self' 'unsafe-inline' https://www.googletagmanager.com",
        "style-src 'self' 'unsafe-inline'",
        "img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com",
        "font-src 'self'",
        "connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com",
        "form-action 'self'",
        "base-uri 'self'",
        "object-src 'none'",
        "manifest-src 'self'",
      ].join("; ")}
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    {/* Favicon — 2 本の rel=icon を形式別に宣言（同じファイルの重複ではなく
         形式違い）することで、ブラウザ品質と Google 発見性を両立する。
         - /favicon.ico: Google と旧ブラウザ向け、ルート直下の標準配置
         - /favicon.svg: 現代ブラウザ向け、高 DPI でクリスプ表示
         - /apple-touch-icon.png: iOS ホーム画面用、別系統
         favicon-32/48 PNG は link 宣言しない（曖昧さ回避）。 */}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    {/* PWA */}
    <link
      rel="manifest"
      href={`/${locale === "en" ? "manifest.en.webmanifest" : "manifest.webmanifest"}`}
    />
    <meta name="theme-color" content="#2563eb" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={siteName} />

    {/* Open Graph / X (旧 Twitter) カード。meta name="twitter:*" は
         X が現在もこの名前で読んでいるため変更不可。 */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={locale === "ja" ? "ja_JP" : "en_US"} />
    <meta property="og:locale:alternate" content={locale === "ja" ? "en_US" : "ja_JP"} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="bg-white text-ink font-sans antialiased min-h-screen flex flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-100 focus:px-4 focus:py-2 focus:bg-primary focus:text-white focus:rounded focus:text-sm focus:font-medium"
    >
      {i.nav.skipToMain}
    </a>
    <Header locale={locale} />
    <main id="main-content" tabindex="-1" class="max-w-4xl w-full mx-auto flex-1 animate-fade-in focus:outline-none">
      <slot />
    </main>
    <Footer locale={locale} />

    {/* 非日本語ブラウザへの言語案内 pill (ja ページ + モバイル幅のみ)。
         デスクトップではヘッダーの LanguageToggle が常時見えるので不要。
         hidden 属性は JS が条件を満たした時だけ外す。md:hidden で
         デスクトップ幅では CSS で非表示にする。 */}
    {locale === "ja" && (
      <div
        id="lang-pill"
        hidden
        class="fixed bottom-6 left-1/2 z-40 md:hidden bg-primary rounded-full pl-4 pr-3 py-2.5 shadow-lg flex items-center gap-3 whitespace-nowrap [@media(display-mode:standalone)]:bottom-[calc(1.5rem+env(safe-area-inset-bottom))]"
      >
        <GlobeIcon size={15} stroke="white" strokeWidth={2} class="shrink-0" />
        <a
          href={getLocalePath("en", normalizedPath)}
          hreflang="en"
          class="text-white text-sm font-semibold no-underline"
          data-lang-pill-link
        >
          {i.nav.switchLanguage}
        </a>
        {/* × は文字グリフだとフォントメトリクス次第で中央からズレるため SVG で描く */}
        <button
          type="button"
          data-lang-pill-close
          aria-label={i.nav.close}
          class="flex items-center justify-center w-7 h-7 rounded-full text-white [@media(hover:hover)]:hover:bg-white/15 cursor-pointer bg-transparent border-0 transition-colors duration-150"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 6 6 18" />
            <path d="m6 6 12 12" />
          </svg>
        </button>
      </div>
    )}

    {/* 出入りのアニメーションは @starting-style + transition-behavior: allow-discrete
         (Baseline 2024) に任せる。JS は hidden 属性の付け外しだけ */}
    <style>
      #lang-pill {
        translate: -50% 0;
        opacity: 1;
        transition:
          opacity 300ms cubic-bezier(0.16, 1, 0.3, 1),
          translate 300ms cubic-bezier(0.16, 1, 0.3, 1),
          display 300ms allow-discrete;
      }
      #lang-pill[hidden] {
        display: none;
        opacity: 0;
        translate: -50% 12px;
      }
      @starting-style {
        #lang-pill {
          opacity: 0;
          translate: -50% 12px;
        }
      }
    </style>
    <script>
      initLangPill();
      function initLangPill() {
        const pill = document.getElementById("lang-pill");
        if (!pill) return;
        const forceShow = new URLSearchParams(location.search).has("force-lang-pill");
        const dismissed = !forceShow && localStorage.getItem("lang-pill-dismissed");
        const isJaBrowser = !forceShow && (navigator.language || "").startsWith("ja");
        if (dismissed || isJaBrowser) return;

        pill.hidden = false;
        pill.querySelector("[data-lang-pill-close]")?.addEventListener("click", () => {
          localStorage.setItem("lang-pill-dismissed", "1");
          pill.hidden = true;
        });
        pill.querySelector("[data-lang-pill-link]")?.addEventListener("click", () => {
          localStorage.setItem("lang-pill-dismissed", "1");
        });
      }
    </script>
  </body>
</html>
